# =====================================================================
# Variáveis de ambiente do app. Copie para `.env` (local) e preencha.
# Na Vercel, cadastre estas mesmas variáveis em Project Settings → Environment
# Variables. O `.env` real NÃO é versionado (ver .gitignore).
# =====================================================================

# --- Supabase (cliente / navegador) ---------------------------------
# Expostas no bundle do front. A publishable key é pública por design.
VITE_SUPABASE_URL="https://SEU_PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"

# --- Supabase (servidor) --------------------------------------------
# Usadas em SSR / server functions / cron. NUNCA expor no front.
SUPABASE_URL="https://SEU_PROJETO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
# service_role: bypassa RLS. Segredo. Só no servidor.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxx"

# --- Controle de acesso ---------------------------------------------
# Único e-mail Google autorizado a usar o app.
LEILOESBR_EMAIL="seu-email@gmail.com"

# --- Credenciais do site de leilões (scraper) -----------------------
LEILOESBR_SENHA="sua-senha-no-leiloesbr"

# --- Proxy do pregão ao vivo (abrir já logado) ----------------------
# Segredo para assinar (HMAC) o token de curta duração do proxy `/api/live`.
# OPCIONAL: sem ele, cai para SUPABASE_SERVICE_ROLE_KEY. Só no servidor.
LIVE_PROXY_SECRET="troque-por-um-token-aleatorio-forte"

# --- Cron (atualização periódica) -----------------------------------
# Token compartilhado entre o GitHub Actions (secret CRON_TOKEN) e o app.
# Gere um valor aleatório forte, ex.: openssl rand -hex 32
CRON_TOKEN="troque-por-um-token-aleatorio-forte"

# --- IA (avaliação/identificação de lotes) --------------------------
# O app é MULTI-PROVEDOR (Claude e/ou Gemini). Basta configurar UMA chave; com
# as duas, é possível alternar na UI e há FAILOVER automático (se um ficar sem
# créditos, o outro assume). Sem NENHUMA chave, a IA faz no-op e o app funciona
# normal (só não mostra a nota/identificação da IA). Só no servidor.
#
# Claude (Anthropic): usada no cron (Batches API) e sob demanda. Cadastre também
# como secret ANTHROPIC_API_KEY no GitHub (para o workflow refresh.yml).
ANTHROPIC_API_KEY="sk-ant-xxx"
# Modelo do Claude (OPCIONAL; padrão: claude-haiku-4-5, o mais barato).
# ANTHROPIC_MODEL="claude-haiku-4-5"

# Gemini (Google AI Studio → "Get API key"). Usada via REST. Cadastre também
# como secret GEMINI_API_KEY no GitHub se o provedor padrão for Gemini.
GEMINI_API_KEY="AI...xxx"
# Modelo do Gemini (OPCIONAL; padrão: gemini-flash-latest, barato).
# GEMINI_MODEL="gemini-flash-latest"

# Provedor de IA PADRÃO quando nada foi escolhido na UI (OPCIONAL; "anthropic"
# | "gemini"; padrão: anthropic). A UI (app_state.ai_provider) tem precedência.
# AI_PROVIDER="anthropic"

# --- Discogs (âncora de preço/demanda de mercado) -------------------
# Personal Access Token do Discogs (Settings → Developers → Generate token).
# Usado só no servidor (cron step=market), com throttle (rate limit 60/min).
# OPCIONAL: sem ele, o passo faz no-op. Também cadastre como secret
# DISCOGS_TOKEN no GitHub (para o workflow refresh.yml).
DISCOGS_TOKEN="seu-token-do-discogs"
