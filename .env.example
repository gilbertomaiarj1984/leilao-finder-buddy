# =====================================================================
# Variáveis de ambiente do app. Copie para `.env` (local) e preencha.
# Em produção (VPS, Fase 4 da migração — docs/economia-fase-2-vps-unico.md), este
# arquivo vira o `.env` ao lado do `docker-compose.yml`, referenciado por `env_file`
# no serviço `app`; fora do repositório, com permissão 600. O `.env` real NÃO é
# versionado (ver .gitignore).
# =====================================================================

# --- Postgres (obrigatória) -------------------------------------------
# Auth (Fase 2), Storage (Fase 3) e o banco (Fase 1) não dependem mais do
# Supabase. No compose (Fase 4), o host é o nome do serviço (`postgres`), na
# rede interna — nunca exposto por porta publicada.
DATABASE_URL="postgresql://garimpo:senha@postgres:5432/garimpo"

# --- Fotos da Coleção em disco (Fase 3 da migração para VPS) ----------
# Pasta no disco onde as fotos são gravadas. No compose (Fase 4) é sempre
# /data/collection (volume compartilhado com o Caddy, que serve os arquivos
# direto — ver Caddyfile); em dev local, sem ela, usa ./data/collection.
# COLLECTION_DIR="/data/collection"
# URL base pública. Em dev local é OPCIONAL (sem ela, usa caminho relativo —
# funciona porque front e back são a mesma origem). Em produção atrás do
# Caddy (Fase 4) é OBRIGATÓRIA: o redirect_uri do login Google usa este valor
# em vez do Host da requisição (sem ela, o Nitro/h3 não confia em
# X-Forwarded-Proto e monta a URL como "http://" mesmo servida em HTTPS — o
# Google recusa por mismatch de protocolo).
PUBLIC_BASE_URL="https://seu-dominio.com"

# =====================================================================
# Variáveis usadas só pelo docker-compose.yml/Caddyfile (Fase 4), não pelo
# app em si — ficam no MESMO .env do VPS por conveniência (docker compose lê
# um `.env` na pasta do projeto automaticamente).
# =====================================================================

# Domínio público do app — o Caddy tira o certificado TLS automático para ele.
# APP_DOMAIN="garimpo.seu-dominio.com"

# Domínio do Portainer (Fase 5 — UI de containers/logs, ver docker-compose.yml). SEMPRE
# um subdomínio PRÓPRIO, nunca um path do domínio do app: ele controla o Docker do VPS
# inteiro (todos os apps da máquina, não só este). Criar o registro DNS A separado antes
# de subir (ver o checklist manual em docs/economia-fase-2-vps-unico.md).
# PORTAINER_DOMAIN="painel.seu-dominio.com"

# Credenciais do Postgres do compose (o serviço `postgres` já lê estas três;
# DATABASE_URL acima precisa bater com elas).
# POSTGRES_USER="garimpo"
# POSTGRES_PASSWORD="troque-por-uma-senha-forte"
# POSTGRES_DB="garimpo"

# Backup noturno (Fase 5 — docker/backup/), pg_dump -> Cloudflare R2 (S3-compatible,
# free 10 GB). Criar o bucket e um API Token "S3" em Cloudflare → R2 → Manage API Tokens;
# o Account ID aparece na URL do painel do R2.
# R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# R2_BUCKET="garimpo-backup"
# R2_ACCESS_KEY_ID="troque"
# R2_SECRET_ACCESS_KEY="troque"

# --- Login com Google (Fase 2 da migração para VPS) ------------------
# OAuth direto (authorization code + PKCE), sem Supabase Auth. Cadastrar em
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (tipo "Web application"), com redirect URI
# "https://SEU_DOMINIO/api/auth/google/callback".
GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxx"
# Segredo para assinar (HMAC) o cookie de sessão e o cookie de PKCE/state do
# login. Gere um valor aleatório forte, ex.: openssl rand -hex 32
SESSION_SECRET="troque-por-um-token-aleatorio-forte"

# --- Controle de acesso ---------------------------------------------
# Único e-mail Google autorizado a usar o app.
LEILOESBR_EMAIL="seu-email@gmail.com"

# --- Credenciais do site de leilões (scraper) -----------------------
LEILOESBR_SENHA="sua-senha-no-leiloesbr"

# --- Proxy do pregão ao vivo (abrir já logado) ----------------------
# Segredo para assinar (HMAC) o token de curta duração do proxy `/api/live`.
# OPCIONAL: sem ele, cai para SUPABASE_SERVICE_ROLE_KEY. Só no servidor.
LIVE_PROXY_SECRET="troque-por-um-token-aleatorio-forte"

# --- Cron (atualização periódica) -----------------------------------
# Token compartilhado entre o GitHub Actions (secret CRON_TOKEN) e o app.
# Gere um valor aleatório forte, ex.: openssl rand -hex 32
CRON_TOKEN="troque-por-um-token-aleatorio-forte"

# --- IA (avaliação/identificação de lotes) --------------------------
# O app é MULTI-PROVEDOR (Claude e/ou Gemini). Basta configurar UMA chave; com
# as duas, é possível alternar na UI e há FAILOVER automático (se um ficar sem
# créditos, o outro assume). Sem NENHUMA chave, a IA faz no-op e o app funciona
# normal (só não mostra a nota/identificação da IA). Só no servidor.
#
# IMPORTANTE (onde cadastrar): estas chaves são lidas pelo SERVIDOR (na Vercel),
# inclusive no cron — o `refresh.yml` só chama o endpoint `/api/cron` com
# APP_URL + CRON_TOKEN. Logo, basta cadastrá-las nas Environment Variables da
# VERCEL (Production). NÃO precisam virar secret no GitHub.
#
# Claude (Anthropic): usada no cron (Batches API) e sob demanda.
ANTHROPIC_API_KEY="sk-ant-xxx"
# Modelo do Claude (OPCIONAL; padrão: claude-haiku-4-5). ~US$1 / US$5 por 1M tok in/out.
# ANTHROPIC_MODEL="claude-haiku-4-5"

# Gemini (Google AI Studio → "Get API key"). Usada via REST.
GEMINI_API_KEY="AI...xxx"
# Modelo do Gemini (OPCIONAL; padrão: gemini-flash-latest — baixo custo, ~US$0,75 /
# US$3,75 por 1M tok in/out, mais barato que o Haiku). Para gastar ainda menos, dá
# para fixar um Flash-Lite (ex.: gemini-2.5-flash-lite), com menos capacidade.
# GEMINI_MODEL="gemini-flash-latest"

# Provedor de IA PADRÃO quando nada foi escolhido na UI (OPCIONAL; "anthropic"
# | "gemini"; padrão: anthropic). A UI (app_state.ai_provider) tem precedência.
# AI_PROVIDER="anthropic"

# --- Discogs (âncora de preço/demanda de mercado) -------------------
# Personal Access Token do Discogs (Settings → Developers → Generate token).
# Usado só no servidor (cron step=market), com throttle (rate limit 60/min).
# OPCIONAL: sem ele, o passo faz no-op. Lido pelo servidor (Vercel) — não é
# secret do GitHub (o workflow só usa APP_URL + CRON_TOKEN).
DISCOGS_TOKEN="seu-token-do-discogs"
